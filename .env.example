# Copy to .env for local `docker compose` / `npm start`. In Portainer, set these as
# stack environment variables instead (the .env file is not in the repository).

# Postgres — the `postgres` container on the pgnet docker network
PGHOST=postgres
PGPORT=5432
PGDATABASE=recomp
PGUSER=recomp
PGPASSWORD=change-me            # same value as in db/init.sql

# Host port to publish the server on
PORT=3000

# Host folder with the .jsx pages (bind-mounted read-only at /pages)
PAGES_PATH=/home/belta1/docker_compose/config/jsx_server

# Only for docker-compose.ghcr.yml: prebuilt image published by GitHub Actions
# IMAGE=ghcr.io/<github-user>/jsx-render:latest
