<?xml version="1.0" encoding="utf-8"?>
<!-- The dashboard is served over plain HTTP on the private network (http://jfubuntu:3000),
     so cleartext must be allowed. The app only ever loads the server you configure. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
