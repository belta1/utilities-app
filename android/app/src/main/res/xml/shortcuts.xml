<?xml version="1.0" encoding="utf-8"?>
<!-- Long-press the launcher icon → "Servidor" opens the server address dialog. -->
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    <shortcut
        android:shortcutId="server"
        android:enabled="true"
        android:icon="@mipmap/ic_launcher"
        android:shortcutShortLabel="@string/shortcut_server">
        <intent
            android:action="com.belta1.recomp.SERVER"
            android:targetPackage="com.belta1.recomp"
            android:targetClass="com.belta1.recomp.MainActivity" />
    </shortcut>
</shortcuts>
